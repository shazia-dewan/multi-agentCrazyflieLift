<mujoco model="CF2 scene">
  <!-- Include drone -->
  <include file="cf2.xml"/>

  <!-- Bounding box and visual scaling of sim -->
  <statistic center="0 0 0.1" extent="0.2" meansize=".05"/>

  <!-- Rendering and highlight options -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-20" elevation="-20" ellipsoidinertia="true"/>
  </visual>

  <!-- Textures and materials -->
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <!-- Physical objects in the world -->
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>

    <!-- Camera to track drone -->
    <camera name="track" pos="-1 0 1" xyaxes="0 0 1 0 1 0" mode="trackcom"/>

    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <geom name="target" type="sphere" size="0.02"
      pos="0 0 1.0" rgba="1 0 0 0.4"
      contype="0" conaffinity="0"
    />

    <!-- XYZ axes visualization -->
    <body name="axes" pos="0 0 0">
      <geom type="capsule" fromto="0 0 0 0.2 0 0" size="0.005" rgba="1 0 0 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0 0.2 0" size="0.005" rgba="0 1 0 1" contype="0" conaffinity="0"/>
      <geom type="capsule" fromto="0 0 0 0 0 0.2" size="0.005" rgba="0 0 1 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
